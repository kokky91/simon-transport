{
  "id": null,
  "uid": "realtime-overview",
  "title": "Realtime Platform Overview",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Events/sec (Publish Rate)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(events_published_total[1m])",
          "legendFormat": "publish/sec",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Publish Latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(event_publish_latency_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active WebSocket Connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "ws_connections_active",
          "legendFormat": "active_ws",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumed vs Broadcast Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(events_consumed_total[1m])",
          "legendFormat": "consumed/sec",
          "refId": "A"
        },
        {
          "expr": "rate(events_broadcast_total[1m])",
          "legendFormat": "broadcast/sec",
          "refId": "B"
        }
      ]
    }
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  }
}
