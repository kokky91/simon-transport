# === App ===
ENV=development
JWT_SECRET=supersecretkey
JWT_ALGORITHM=HS256
RATE_LIMIT_API_WRITE_PER_MINUTE=120
WS_HANDSHAKE_RATE_LIMIT_PER_MINUTE=120
WS_MAX_CONNECTIONS_PER_TENANT=200
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5175
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Trace-Id
TRUSTED_HOSTS=localhost,127.0.0.1,api
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5175
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000
API_PORT=8002
REALTIME_PORT=8003
REDIS_HOST_PORT=6380
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# === Worker Autoscaling (Compose baseline) ===
WORKER_MIN_REPLICAS=1
WORKER_MAX_REPLICAS=6
WORKER_SCALE_UP_STEP=1
WORKER_SCALE_DOWN_STEP=1
WORKER_SCALE_COOLDOWN_SECONDS=120
WORKER_SCALE_UP_BACKLOG_THRESHOLD=10
WORKER_SCALE_UP_LATENCY_P95_THRESHOLD=0.35
WORKER_SCALE_DOWN_PUBLISH_RATE_THRESHOLD=3
WORKER_SCALE_DOWN_BACKLOG_THRESHOLD=0.5
WORKER_SCALE_DOWN_LATENCY_P95_THRESHOLD=0.2

# === Database ===
POSTGRES_DB=farmplatform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/farmplatform

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# === Worker ===
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
GAME_TICK_RATE_SECONDS=1.0
GAME_TICK_TENANT_ID=tenant-game-loop
GAME_WORLD_ID=tenant-game-loop:world
GAME_WORLD_LOCK_TTL_SECONDS=5
GAME_TICK_SIMULATED_WORK_SECONDS=0
WORKER_METRICS_PORT=9102
WORKER_METRICS_HOST_PORT=9102

# === Local AI (Ollama) ===
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# === Global AI provider (app-wide) ===
# Supported providers: ollama, openai_compatible
AI_PROVIDER=ollama
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL=llama3.2
AI_API_KEY=
